# 应用配置
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端访问地址（用于邮件中的链接）
APP_BASE_URL=http://127.0.0.1

# 数据库配置
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=your_database_name

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT 配置
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP 邮件配置（用于注册验证）
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SENDER=noreply@example.com
SMTP_PASSWORD=your_smtp_password

# Chroma DB 配置
CHROMA_DB_PATH=D:\PolyPlex\file\chroma_db

# LangChain/AI 配置
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_BASE_URL=https://cloud.infini-ai.com/maas/v1

# 文件相关配置
FILE_PATH=D:\PolyPlex\file\uploads
# 最大文件大小(MB)
MAX_FILE_SIZE=10240

# 系统用户创建时的信息
SYSTEM_USERNAME=admin
SYSTEM_USER_PASSWORD=your_admin_password
